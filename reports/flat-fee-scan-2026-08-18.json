{
  "title": "Flat-fee (fabricated tuition) scan across all live universities",
  "date": "2026-08-18",
  "status": "SCAN COMPLETE — phase 1 partially executed 2026-08-25, see phase1Outcome",
  "headline": [
    "73 of 101 universities with a priced catalogue show the same fabricated flat-fee signature already fixed for the 9 Australian files — 15,583 courses.",
    "That is roughly 5x the size of the completed Australian tuition fix (3,257 courses), and it is the dominant pattern in the registry rather than an exception."
  ],
  "method": {
    "signature": "A large catalogue whose native-currency annual fee takes only a handful of distinct values, because the generator assigned a constant per degree BAND rather than crawling per course.",
    "threshold": "<= 12 distinct fee values with >= 50 priced courses.",
    "corroboratingTest": {
      "what": "Fabricated bands are round numbers; genuinely crawled fees are irregular.",
      "result": "Flagged files: 63% of distinct fee values are exact multiples of 1000 (80% multiples of 500). Genuinely crawled files: 11% multiples of 1000 (18% of 500).",
      "why": "Two independent signals agreeing makes this a strong finding rather than an artefact of the distinct-count threshold alone."
    },
    "controlGroup": "The 9 Australian files fixed in the previous pass now sit in the clean bucket (Adelaide 54 distinct values, USyd 39, RMIT 82, UoM 104, Griffith 50), alongside genuinely-crawled UTS (121). They are the shape a real fee crawl produces."
  },
